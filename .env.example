# ==============================================================================
# Re:Code Environment Configuration Template
# Read. Review. Refine. - Automated Code Diagnostics & AST Analysis Platform
# ==============================================================================
# Copy this file to '.env' in your local environment and fill in the active credentials.
# WARNING: Never commit real API keys or secrets to version control.

# ------------------------------------------------------------------------------
# 1. Server & Runtime Settings
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. Database & Authentication (Supabase)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_REST_URL=https://your-project-id.supabase.co/rest/v1/
SUPABASE_ANON_KEY=your-anon-token-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_DB_PASSWORD=your-db-password-here

# ------------------------------------------------------------------------------
# 3. AI Diagnostics & Remediation Engine (Google Gemini)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_MODEL=gemini-1.5-pro

# ------------------------------------------------------------------------------
# 4. GitHub Integration
# ------------------------------------------------------------------------------
GITHUB_TOKEN=your-fine-grained-github-pat-here

# ------------------------------------------------------------------------------
# 5. Rate-Limiting & Security Safeguards
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AI_MAX_REQUESTS=20
RATE_LIMIT_GITHUB_MAX_REQUESTS=30

# ------------------------------------------------------------------------------
# 6. Engine & Cache Configuration (Optional)
# ------------------------------------------------------------------------------
AST_CACHE_ENABLED=true
AST_CACHE_DIR=.audit_cache
