{
  "name": "recode-app",
  "version": "1.0.0",
  "private": true,
  "description": "Re:Code - Read. Review. Refine. Automated code review, static AST analysis & AI diagnostics platform.",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:all": "npm run dev --workspaces --if-present",
    "test:all": "npm run test --workspaces --if-present",
    "build:all": "npm run build --workspaces --if-present",
    "lint:all": "npm run lint --workspaces --if-present",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend"
  },
  "keywords": [
    "recode",
    "code-review",
    "ast",
    "static-analysis",
    "security-scanner",
    "gemini-ai",
    "monorepo"
  ],
  "author": "Shivam Vishwakarma",
  "license": "MIT"
}
